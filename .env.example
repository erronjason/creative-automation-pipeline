# Copy to .env and fill in what you have. Nothing here is required for the offline demo.

# --- OpenAI (live image generation + outpainting, and machine translation) ---------------
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_QUALITY=medium          # low | medium | high
# OPENAI_HERO_SIZE=1024                # square hero edge in px (multiple of 16)
# OPENAI_TEXT_MODEL=gpt-5.6-luna       # used for transcreation when a locale has no approved copy
# OPENAI_EST_COST_PER_IMAGE=0.05       # planning estimate shown in reports; not billing data

# --- OpenRouter (one key for many image models + machine translation; no OpenAI key needed) ---
OPENROUTER_API_KEY=
# OPENROUTER_IMAGE_MODEL=openai/gpt-image-2   # any id from https://openrouter.ai/api/v1/images/models
# OPENROUTER_IMAGE_QUALITY=                   # low | medium | high; leave empty for models without `quality`
# OPENROUTER_HERO_SIZE=1024
# OPENROUTER_EXPAND_LAYOUT=blur               # outpaint reference: blur | mirror | transparent
# OPENROUTER_TEXT_MODEL=openai/gpt-5.6-luna   # transcreation when a locale has no approved copy
# OPENROUTER_EST_COST_PER_IMAGE=0.05          # planning estimate only; reports use billed usage.cost

# --- Adobe Firefly Services (enterprise org credential from Adobe Developer Console) -----
FIREFLY_CLIENT_ID=
FIREFLY_CLIENT_SECRET=
# FIREFLY_MODEL_VERSION=               # optional x-model-version header
# FIREFLY_RPM=4                        # org rate limit; the provider throttles to it
# FIREFLY_EST_COST_PER_IMAGE=0.04

# --- S3 storage (optional: `--output s3://bucket/prefix`, needs `pip install ".[s3]"`) ---
# AWS_PROFILE=
# AWS_REGION=us-east-1
